<?xml version="1.0" encoding="utf-8"?>
<!-- Phần viết tay cho Gazebo Harmonic (gz-sim 8): plugin, cảm biến, ma sát.
     Tách riêng khỏi da_cdt_robot_core.xacro để xuất lại từ SolidWorks không làm mất. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Publish trạng thái các joint lên topic gz "joint_states",
       được ros_gz_bridge chuyển sang ROS 2 topic /joint_states -->
  <gazebo>
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- Bộ điều khiển vi sai: nhận /cmd_vel, publish /odom và TF odom -> base_footprint.
       wheel_separation = khoảng cách tâm 2 bánh (0.0921 * 2),
       wheel_radius đo từ mesh link_left_wheel.STL.

       Giới hạn gia tốc: trọng tâm robot chỉ nằm trước trục bánh ~1.7 cm và cao ~10 cm,
       caster ở phía trước, nên tăng tốc tiến quá ~1.6 m/s^2 robot sẽ bị chổng đầu.
       Không tăng max_linear_acceleration quá ~1.2.
       Giới hạn vận tốc: giá trị tạm, cần chỉnh theo tốc độ thật của động cơ JGB37-520
       (v_max = rpm / 60 * 2 * pi * 0.034; ví dụ 178 rpm -> 0.63 m/s). -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>joint_left_wheel</left_joint>
      <right_joint>joint_right_wheel</right_joint>
      <wheel_separation>0.1842</wheel_separation>
      <wheel_radius>0.034</wheel_radius>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>4.0</max_angular_velocity>
      <min_angular_velocity>-4.0</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- ===== Camera Orbbec Astra (RGB + Depth) ===== -->
  <!-- rgbd_camera tạo ra cả ảnh màu (RGB) và ảnh độ sâu (Depth) từ 1 cảm biến.
       Thông số theo Astra: FOV ngang 60 độ, tầm đo depth đến 8 m. Độ phân giải hạ từ
       640x480 (Astra thật) xuống 320x240 vì Gazebo xử lý RGB-D trên CPU: 640x480 chỉ đạt ~10 Hz.

       frame_id là link_camera_optical (chuẩn ROS) để ảnh + camera_info đúng cho các node
       như depth_image_proc. Point cloud của Gazebo lại tính theo hệ x ra trước nên KHÔNG
       bridge nó; point cloud được tạo lại từ ảnh depth bằng depth_image_proc
       (gazebo.launch.py pointcloud:=true). -->
  <gazebo reference="link_camera">
    <sensor name="astra" type="rgbd_camera">
      <pose>0.023 0 0.022 0 0 0</pose>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <topic>camera</topic>
      <gz_frame_id>link_camera_optical</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>8.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>8.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <!-- Giữ 2 joint caster (fixed) thành link riêng trong SDF thay vì gộp vào base_link,
       để ma sát thấp bên dưới chỉ áp cho hình cầu của bánh caster -->
  <gazebo reference="joint_caster1">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="joint_caster2">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- Bánh chủ động bám đường, bánh caster gần như không ma sát -->
  <gazebo reference="link_left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="link_right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="link_caster2">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
</robot>
